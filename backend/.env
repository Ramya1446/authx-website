# Authx Backend Configuration

# Blockchain Mode
# Options: "simulation", "ganache", "polygon", "ethereum"
BLOCKCHAIN_MODE=simulation

# Ganache Configuration (for local testing)
GANACHE_URL=http://127.0.0.1:7545

# Polygon Configuration
# Get RPC URL from: https://polygon.technology/
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
# For mainnet: https://polygon-rpc.com

# Ethereum Configuration  
# Get API key from Infura (infura.io) or Alchemy (alchemy.com)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Wallet Configuration
# WARNING: Never commit this file with real private keys!
# For production, use environment variables or secret management
PRIVATE_KEY=your_wallet_private_key_here

# Smart Contract Address
# Deploy contract first, then add address here
CONTRACT_ADDRESS=0x53881E98C7Ff0986861dB541206E604a2345A5B1

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Database
DATABASE_PATH=authx.db

# Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,mp3,wav,txt,pdf,doc,docx

# AI Model Configuration
USE_ADVANCED_AI_MODELS=False
AI_MODEL_PATH=./models/

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=authx.log

BLOCKCHAIN_MODE=ganache
GANACHE_URL=http://127.0.0.1:7545
PRIVATE_KEY=0x16463531464e48e08bb4ec23e8e76b02003692e5a6f40b6e12dd85757a4573fa
CONTRACT_ADDRESS=0x53881E98C7Ff0986861dB541206E604a2345A5B1